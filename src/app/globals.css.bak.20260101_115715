/* src/app/globals.css */

@config "../../tailwind.config.ts";
@import "tailwindcss";

/* =========================================
   Apple-like Design Tokens (Light/Dark)
   - Default: System
   - Optional override via <html data-theme="dark|light">
   ========================================= */

:root {
  --accent: 227 6 19; /* DITIB red as RGB */

  /* Typography */
  --text: 17 17 17;
  --muted: 99 99 102;

  /* Surfaces (Light) */
  --bg: 245 245 247;
  --surface: 255 255 255;
  --surface-2: 250 250 252;
  --border: 210 210 215;

  /* Shadows */
  --shadow: 0 12px 30px rgba(0, 0, 0, 0.08);

  /* Radius */
  --r-xl: 20px;
  --r-lg: 16px;
  --r-md: 12px;
  --r-sm: 10px;

  /* Focus */
  --focus: 0 0 0 3px rgba(227, 6, 19, 0.25);
}

/* Dark Mode – System */
@media (prefers-color-scheme: dark) {
  :root {
    --text: 235 235 245;
    --muted: 152 152 160;

    --bg: 10 10 12;
    --surface: 18 18 22;
    --surface-2: 24 24 28;
    --border: 44 44 52;

    --shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
  }
}

/* Explicit override */
html[data-theme="light"] {
  --text: 17 17 17;
  --muted: 99 99 102;

  --bg: 245 245 247;
  --surface: 255 255 255;
  --surface-2: 250 250 252;
  --border: 210 210 215;

  --shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
}

html[data-theme="dark"] {
  --text: 235 235 245;
  --muted: 152 152 160;

  --bg: 10 10 12;
  --surface: 18 18 22;
  --surface-2: 24 24 28;
  --border: 44 44 52;

  --shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
}

/* Base */
html,
body {
  height: 100%;
}

body {
  background: rgb(var(--bg));
  color: rgb(var(--text));
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* =========================================
   Reusable UI primitives (central!)
   ========================================= */

.ui-card {
  background: rgb(var(--surface));
  border: 1px solid rgb(var(--border));
  border-radius: var(--r-xl);
  box-shadow: var(--shadow);
}

.ui-surface {
  background: rgb(var(--surface));
  border: 1px solid rgb(var(--border));
  border-radius: var(--r-lg);
}

.ui-muted {
  color: rgb(var(--muted));
}

.ui-border {
  border-color: rgb(var(--border));
}

/* Inputs */
.ui-input {
  width: 100%;
  border-radius: var(--r-md);
  border: 1px solid rgb(var(--border));
  background: rgb(var(--surface-2));
  color: rgb(var(--text));
  padding: 10px 12px;
  outline: none;
}

.ui-input:focus {
  box-shadow: var(--focus);
  border-color: rgba(227, 6, 19, 0.55);
}

/* Buttons */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  border: 1px solid rgb(var(--border));
  background: rgb(var(--surface));
  color: rgb(var(--text));
  padding: 10px 12px;
  font-weight: 600;
  transition: transform 0.06s ease, background 0.15s ease,
    border-color 0.15s ease;
}

.ui-btn:hover {
  background: rgba(0, 0, 0, 0.03);
}

@media (prefers-color-scheme: dark) {
  .ui-btn:hover {
    background: rgba(255, 255, 255, 0.05);
  }
}

.ui-btn:active {
  transform: scale(0.99);
}

.ui-btn-primary {
  background: rgb(var(--accent));
  border-color: rgba(0, 0, 0, 0.12);
  color: white;
}

.ui-btn-primary:hover {
  filter: brightness(0.98);
}

.ui-btn-ghost {
  background: transparent;
}

.ui-btn:disabled,
.ui-btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

/* Keep legacy class names but map to the new primitives */
.ditib-card {
  background: rgb(var(--surface));
  border: 1px solid rgb(var(--border));
  border-radius: var(--r-xl);
  box-shadow: var(--shadow);
}

.ditib-btn {
  background: rgb(var(--accent));
  color: white;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: var(--r-md);
}

.ditib-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
